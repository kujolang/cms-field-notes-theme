{
  "name": "@kujolang/cms-field-notes-theme",
  "version": "1.0.3",
  "private": false,
  "description": "A portable editorial theme for Kujo CMS.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.5 <23 || >=24.22.3 <25 || >=26.13.1"
  },
  "scripts": {
    "dev": "vinext dev --host 127.0.0.1 --port 3000",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "package": "node scripts/package-theme.mjs",
    "test": "npm run test:dependency-security && node --disable-warning=ExperimentalWarning --test tests/delivery.test.mjs && npm run lint && npm run typecheck && npm run build && npm audit --audit-level=low",
    "test:dependency-security": "node --test tests/dependency-security.test.mjs",
    "typecheck": "tsc --noEmit --incremental false"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "react": "19.2.9",
    "react-dom": "19.2.9"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.66.0",
    "@cloudflare/workers-types": "5.20261023.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "braces": "file:vendor/braces",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.9",
    "typescript": "5.9.3",
    "typescript-eslint": "8.74.0",
    "vinext": "1.0.0",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "type": "module",
  "overrides": {
    "braces": "$braces",
    "satori": {
      "fflate": "0.7.5"
    }
  }
}
