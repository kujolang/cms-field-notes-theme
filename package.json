{
  "name": "@kujolang/cms-field-notes-theme",
  "version": "1.0.3",
  "private": false,
  "description": "A portable editorial theme for Kujo CMS.",
  "license": "MIT",
  "engines": {
    "node": ">=22.23.4 <23 || >=24.22.1 <25 || >=26.12.1"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "package": "node scripts/package-theme.mjs",
    "test": "npm run test:dependency-security && npm run lint && npm run build && npm audit --audit-level=low",
    "test:dependency-security": "node --test tests/dependency-security.test.mjs"
  },
  "dependencies": {
    "@tabler/icons-react": "^3.46.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.63.1",
    "@eslint/js": "9.39.4",
    "@next/eslint-plugin-next": "16.4.0",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.35",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "react-server-dom-webpack": "19.2.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vinext": "1.0.0-beta.11",
    "vite": "8.3.5",
    "wrangler": "4.149.0",
    "braces": "file:vendor/braces"
  },
  "type": "module",
  "overrides": {
    "braces": "$braces"
  }
}
